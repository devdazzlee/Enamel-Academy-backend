          ],
          "query": [
            {
              "key": "email",
              "value": "apiusertes111@gmail.com"
            },
            {
              "key": "password",
              "value": "newpassword@123"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Capture JWT token from login response",
              "try {",
              "  const body = pm.response.json();",
              "  const token = body.token || (body.data && (body.data.token || body.data.jwt)) || body.jwt;",
              "  if (token) {",
              "    pm.environment.set(\"token\", token);",
              "    pm.globals.set(\"token\", token);",
              "    pm.test(\"Saved token\", () => pm.expect(token).to.be.a(\"string\"));",
              "  } else {",
              "    pm.test(\"Token not found in login response\", () => { throw new Error(\"Missing token in response\"); });",
              "  }",
              "} catch (e) {",
              "  pm.test(\"Login response parse error\", () => { throw e; });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// LOG_RESPONSE",
