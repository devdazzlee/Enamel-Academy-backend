              "raw": "{\n    \"name\": \"2025 Professional Development Plan\",\n    \"description\": \"Comprehensive PDP focusing on advanced endodontics and implantology\",\n    \"status\": \"active\",\n    \"year\": \"2025\",\n    \"start_date\": \"2025-01-01\",\n    \"end_date\": \"2025-12-31\",\n    \"career_objectives\": [\n        {\n            \"objective\": \"Become a specialist in Advanced Endodontics\",\n            \"specialty\": \"Endodontics\",\n            \"priority\": 1\n        },\n        {\n            \"objective\": \"Achieve proficiency in Digital Smile Design\",\n            \"specialty\": \"Digital Dentistry\",\n            \"priority\": 2\n        },\n        {\n            \"objective\": \"Obtain Implantology Certification\",\n            \"specialty\": \"Implantology\",\n            \"priority\": 3\n        }\n    ],\n    \"current_skills\": [\n        {\n            \"skill_name\": \"General Dentistry\",\n            \"current_proficiency\": \"Advanced\",\n            \"target_proficiency\": \"Expert\"\n        },\n        {\n            \"skill_name\": \"Root Canal Treatment\",\n            \"current_proficiency\": \"Intermediate\",\n            \"target_proficiency\": \"Advanced\"\n        }\n    ],\n    \"skills_to_develop\": [\n        {\n            \"skill_name\": \"Endodontics\",\n            \"target_proficiency\": \"Advanced\",\n            \"priority\": 1\n        },\n        {\n            \"skill_name\": \"Implantology\",\n            \"target_proficiency\": \"Advanced\",\n            \"priority\": 2\n        },\n        {\n            \"skill_name\": \"Digital Dentistry\",\n            \"target_proficiency\": \"Advanced\",\n            \"priority\": 3\n        }\n    ],\n    \"learning_activities\": [\n        {\n            \"activity_name\": \"Advanced Endodontics Masterclass\",\n            \"activity_type\": \"course\",\n            \"duration_hours\": 40,\n            \"priority\": 1,\n            \"status\": \"planned\",\n            \"start_date\": \"2025-02-01\"\n        },\n        {\n            \"activity_name\": \"Digital Smile Design Workshop\",\n            \"activity_type\": \"workshop\",\n            \"duration_hours\": 20,\n            \"priority\": 2,\n            \"status\": \"planned\",\n            \"start_date\": \"2025-03-15\"\n        },\n        {\n            \"activity_name\": \"Implantology Certification Program\",\n            \"activity_type\": \"course\",\n            \"duration_hours\": 60,\n            \"priority\": 3,\n            \"status\": \"planned\",\n            \"start_date\": \"2025-04-10\"\n        }\n    ],\n    \"milestones\": [\n        {\n            \"title\": \"Complete Endodontics course\",\n            \"description\": \"Finish all modules and pass final assessment\",\n            \"due_date\": \"2025-03-31\",\n            \"quarter\": \"Q1\",\n            \"completed\": false\n        },\n        {\n            \"title\": \"Finish Digital Smile Design\",\n            \"description\": \"Complete workshop and submit final project\",\n            \"due_date\": \"2025-06-30\",\n            \"quarter\": \"Q2\",\n            \"completed\": false\n        },\n        {\n            \"title\": \"Complete all certifications\",\n            \"description\": \"Finish all planned courses and obtain certificates\",\n            \"due_date\": \"2025-12-31\",\n            \"quarter\": \"Q4\",\n            \"completed\": false\n        }\n    ],\n    \"reflection\": {\n        \"content\": \"This year has been transformative for my dental career. The combination of advanced endodontics training and digital dentistry skills has significantly enhanced my clinical capabilities.\",\n        \"achievements\": \"Completed 4 advanced courses, gained proficiency in 3 new dental specialties, logged 150 CPD hours\",\n        \"challenges\": \"Time management between courses and clinical work, adapting to new digital workflows\"\n    },\n    \"achievements\": [\